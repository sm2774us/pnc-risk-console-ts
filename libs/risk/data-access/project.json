{
  "name": "risk-data-access",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/risk/data-access/src",
  "projectType": "library",
  "prefix": "pnc",
  "tags": ["scope:risk", "type:data-access"],
  "targets": {
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "libs/risk/data-access/tsconfig.spec.json",
        "buildTarget": "risk-console:build:development",
        "include": ["libs/risk/data-access/src/**/*.spec.ts"],
        "runner": "vitest",
        "coverage": true,
        "coverageReporters": ["text-summary", "lcov"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.lib.json --noEmit && tsc -p tsconfig.spec.json --noEmit", "cwd": "libs/risk/data-access" }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
