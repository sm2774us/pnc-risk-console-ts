{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/vitest.config.ts", "!{projectRoot}/eslint.config.mjs"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package-lock.json"]
  },
  "targetDefaults": {
    "build": { "dependsOn": ["^build"], "inputs": ["production", "^production"], "cache": true },
    "test": { "inputs": ["default", "^production"], "cache": true },
    "lint": { "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"], "cache": true },
    "typecheck": { "inputs": ["default", "^production"], "cache": true }
  },
  "analytics": false
}
