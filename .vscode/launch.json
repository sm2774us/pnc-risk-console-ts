{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1 · Chrome → Angular (needs `npm run dev`)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": { "webpack:///./*": "${webRoot}/*" }
    },
    {
      "name": "2 · Node → BFF (tsx, breakpoints in TS)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "--inspect-brk=9229", "apps/bff/src/main.ts"],
      "env": { "NODE_ENV": "development", "LOG_LEVEL": "debug" },
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "3 · Attach → BFF container/process (:9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "localRoot": "${workspaceFolder}",
      "remoteRoot": "/app"
    },
    {
      "name": "4 · Vitest → current file (BFF/libs)",
      "type": "node",
      "request": "launch",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": ["run", "--no-file-parallelism", "${relativeFile}"],
      "console": "integratedTerminal"
    },
    {
      "name": "5 · Playwright → debug current spec",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@playwright/test/cli.js",
      "args": ["test", "-c", "apps/risk-console-e2e/playwright.config.ts", "--debug", "${file}"],
      "env": { "PWDEBUG": "1" },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "Full stack (BFF + Chrome)",
      "configurations": ["2 · Node → BFF (tsx, breakpoints in TS)", "1 · Chrome → Angular (needs `npm run dev`)"],
      "stopAll": true
    }
  ]
}
