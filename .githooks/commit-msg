#!/bin/sh
# Conventional Commits: type(scope)!: subject
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,100}$'
head -n1 "$1" | grep -Eq "$pattern" || { echo "Commit message must follow Conventional Commits, e.g. 'feat(exposure): add peril filter'"; exit 1; }
